{
  "id": "countries-over-time",
  "title": "Query the boundaries or the area of countries over time",
  "description": "This query returns either the boundary geometry (geometry) or the area in square kilometers of one or more countries (area) over time with the country name (name), the name of the capital (capname) and the Gleditsch and Ward code (gwcode) for each time period. The start and end date of the time period for which the data is valid is also returned (gwsdate and gwedate).",
  "collections": ["boundary"],
  "filter": {
    "op"  : "in",
    "args": [
      { "property": "name"                          },
      { "$parameter": {"$ref": "#/parameters/name"} }
    ]
  },
  "supportPaging": true,
  "limit": 1000,
  "maxAllowableOffset": 0.1,
  "properties": ["fid", "gwsdate", "gwedate", "name", "capname", "gwcode", {"$parameter": {"$ref": "#/parameters/area_or_geometry"}}],
  "parameters": {
